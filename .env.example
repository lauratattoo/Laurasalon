# Optional automatic emails; without them Laura confirms bookings personally:
# RESEND_API_KEY=re_...
# EMAIL_FROM=Salon tattoo Laura <rezervace@your-verified-domain.cz>
SALON_EMAIL=Tattoolaura@seznam.cz
