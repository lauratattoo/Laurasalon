PORT=3000
# Set a unique password with at least 12 characters.
ADMIN_PASSWORD=change-this-to-a-long-unique-password
SESSION_SECRET=change-this-to-a-random-secret-at-least-32-characters
DATA_DIR=./data
APP_MODE=demo
